---
import { profile } from "../data/profile";

const { title, text } = Astro.props;
---

<section class="page-header">
  <div class="page-header__image" aria-hidden="true">
    <img
      src={profile.images.campus.src}
      alt=""
      width={profile.images.campus.width}
      height={profile.images.campus.height}
    />
  </div>
  <div class="container">
    <h1>{title}</h1>
    {text ? <p>{text}</p> : null}
  </div>
</section>
