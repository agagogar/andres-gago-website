---
import { getCollection } from "astro:content";
import AuthorLinks from "../components/AuthorLinks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const categories = [
  { slug: "publications", label: "Publications" },
  { slug: "working-papers", label: "Working Papers" },
  { slug: "work-in-progress", label: "Work in Progress" },
  { slug: "other-research-work", label: "Other Research Work" }
] as const;

const research = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Research"
  description="Research by Andrés Gago, organized by publications, work in progress, and other research work."
>
  <PageHeader title="Research" />

  {
    categories.map((category) => {
      const items = research.filter((item) => item.data.category === category.slug);
      if (items.length === 0) return null;
      const showDateWithVenue =
        category.slug === "publications" || category.slug === "other-research-work";
      return (
        <section class="section">
          <div class="container">
            <h2>{category.label}</h2>
            <ol class="entry-list">
                {items.map((item) => (
                  <li class="entry">
                    <div class="entry-title-row">
                      <h3>{item.data.title}</h3>
                      {item.data.dateLabel && !showDateWithVenue ? (
                        <span class="entry-date">{item.data.dateLabel}</span>
                      ) : null}
                    </div>
                    <AuthorLinks authors={item.data.authors} />
                    {item.data.venue ? (
                      <p class="entry-meta">
                        {item.data.venue}
                        {item.data.dateLabel && showDateWithVenue ? ` · ${item.data.dateLabel}` : null}
                      </p>
                    ) : null}
                    {item.data.status ? (
                      category.slug === "work-in-progress" ? (
                        <p class="entry-status"><span>Status:</span> {item.data.status}</p>
                      ) : (
                        <p class="entry-status">{item.data.status}</p>
                      )
                    ) : null}
                    {item.data.links.length > 0 ? (
                      <ul class="inline-links">
                        {item.data.links.map((link) => (
                          <li>
                            <a href={link.url} rel="noreferrer" target="_blank">{link.label}</a>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </li>
                ))}
            </ol>
          </div>
        </section>
      );
    })
  }
</BaseLayout>
